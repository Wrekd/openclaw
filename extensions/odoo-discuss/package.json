{
  "name": "@openclaw/odoo-discuss",
  "version": "2026.5.24",
  "description": "OpenClaw Odoo Discuss channel plugin",
  "type": "module",
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.24"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": ["./index.ts"],
    "release": {
      "publishToNpm": true
    },
    "install": {
      "minHostVersion": ">=2026.5.0"
    },
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "odoo-discuss",
      "label": "Odoo Discuss",
      "selectionLabel": "Odoo Discuss (ERP Chat)",
      "detailLabel": "Odoo Discuss",
      "docsPath": "/channels/odoo-discuss",
      "docsLabel": "odoo-discuss",
      "blurb": "Odoo ERP internal messaging via XML-RPC.",
      "aliases": ["odoo", "odoo-chat"],
      "systemImage": "message",
      "configuredState": {
        "env": {
          "allOf": ["ODOO_DISCUSS_URL", "ODOO_DISCUSS_DB", "ODOO_DISCUSS_USER", "ODOO_DISCUSS_PASSWORD"]
        }
      },
      "order": 150
    }
  }
}
